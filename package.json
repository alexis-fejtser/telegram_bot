{
  "name": "tgbot",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 --env-file=tests/.env.test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch --test-concurrency=1 --env-file=tests/.env.test \"tests/**/*.test.js\"",
    "migrate:scene-order": "node scripts/migrateSceneOrder.js",
    "warmup:media": "node scripts/warmupMedia.js",
    "client:install": "npm install --prefix client --include=dev",
    "client:build": "npm run build --prefix client",
    "build": "npm run client:install && npm run client:build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
